# EquipLoop Server - Environment Variables
# For local development: http://localhost:3000
# For Vercel production: https://<your-client-app>.vercel.app
PORT=5000
CLIENT_URL=http://localhost:3000

# Shared MongoDB Database (Same DB_URI and DB_NAME used in equiploop-client)
DB_URI=mongodb://localhost:27017
DB_NAME=equiploop

# Stripe Payment Processing (Webhooks not required: verified directly via session ID on success URL)
STRIPE_SECRET_KEY=sk_test_placeholder

# Optional Automated Email Notifications (SMTP)
# If empty, a simulated console logger will record transactional completion emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EquipLoop Platform" <notifications@equiploop.com>
